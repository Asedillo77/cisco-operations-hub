<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Connectivity Evidence Run Summary</title>
  <style>
    :root { --ink: #102a43; --muted: #52667a; --line: #d8e2eb; --accent: #007f86; }
    * { box-sizing: border-box; }
    body { margin: 0; background: #f5f8fa; color: var(--ink); font: 15px/1.5 Arial, sans-serif; }
    main { width: min(1120px, calc(100% - 32px)); margin: 32px auto; }
    header, table { background: #fff; border: 1px solid var(--line); border-radius: 10px; }
    header { padding: 24px; border-top: 6px solid var(--accent); }
    h1 { margin: 0 0 8px; }
    p { margin: 0; color: var(--muted); }
    .table-wrap { margin-top: 20px; overflow-x: auto; }
    table { width: 100%; border-collapse: separate; border-spacing: 0; overflow: hidden; }
    th, td { padding: 13px 16px; text-align: left; border-bottom: 1px solid var(--line); }
    th { background: #eaf5f5; white-space: nowrap; }
    tr:last-child td { border-bottom: 0; }
    td.summary { min-width: 300px; max-width: 620px; overflow-wrap: anywhere; }
    a { color: #006b72; font-weight: 700; }
  </style>
</head>
<body>
<main>
  <header>
    <h1>Connectivity Evidence Run Summary</h1>
    <p>{{ summary.site_count }} site(s), {{ summary.device_count }} device(s) · {{ "Dry-run" if summary.dry_run else "Live collection" }} · {{ summary.generated_at }}</p>
  </header>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Site</th><th>Devices</th><th>Status</th><th>Summary</th><th>Reports</th></tr></thead>
      <tbody>
      {% for site in summary.sites %}
        <tr>
          <td>{{ site.site }}</td><td>{{ site.devices }}</td><td>{{ site.status|title }}</td>
          <td class="summary">{{ site.summary }}</td>
          <td><a href="{{ site.html_report }}">HTML</a> · <a href="{{ site.json_report }}">JSON</a></td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
</main>
</body>
</html>
